# ==================================
# 环境配置文件:修改名称example为.env.dev或.env.prod
# 修改内容：ENVIRONMENT、DATABASE_PASSWORD、REDIS_PASSWORD、OPENAI_API_KEY
# ==================================

ENVIRONMENT = dev # prod

# 服务器配置
SERVER_HOST = localhost
SERVER_PORT = 8001
CAPTCHA_ENABLE = false

# 文档配置
DEBUG = True
VERSION = 3.1.0

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置：mysql-3306、postgres-5432、sqlite
DATABASE_TYPE = mysql
DATABASE_HOST = localhost
DATABASE_PORT = 3306
DATABASE_USER = root
DATABASE_PASSWORD = your_database_password
DATABASE_NAME = fastapiadmin

# Redis配置
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = your_redis_password
REDIS_DB_NAME = 1

# 日志级别配置
LOGGER_LEVEL = DEBUG

# 大模型配置
OPENAI_BASE_URL = https://api.deepseek.com
OPENAI_API_KEY = your_api_key
OPENAI_MODEL = deepseek-v4-flash

# 腾讯云短信（密钥只放环境变量；模板启停在运营后台配置）
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_LOGIN=
TENCENT_SMS_TEMPLATE_REGISTER=
TENCENT_SMS_TEMPLATE_BIND=
TENCENT_SMS_TEMPLATE_RESET_PASSWORD=

# 支付回调公网根地址（商户密钥与证书路径只放环境变量）
PAYMENT_PUBLIC_BASE_URL=https://api.example.com
# 微信支付 Native
CLIENT_WECHAT_LOGIN_APP_ID=
CLIENT_WECHAT_LOGIN_APP_SECRET=
# 网站应用微信登录审核域名须覆盖此 HTTPS 地址的主机名，路径固定为 /api/v1/client/auth/wechat/callback
CLIENT_WECHAT_LOGIN_CALLBACK_URL=https://www.example.com/api/v1/client/auth/wechat/callback
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=

# 支付宝当面付（私钥与支付宝公钥路径只放环境变量）
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=

# 支付宝商户转账（推广提现），不同于客户扫码付款。
# 完成转账产品审核和转账场景申明后再启用。
GROWTH_ALIPAY_PAYOUT_ENABLED=false
GROWTH_PAYOUT_ENCRYPTION_KEY=
GROWTH_ALIPAY_TRANSFER_SCENE_NAME=
GROWTH_ALIPAY_SCENE_REPORT_JSON=
# 证书模式需要应用证书、支付宝根证书，并将 ALIPAY_PUBLIC_KEY_PATH 指向支付宝公钥证书。
# 普通公钥收款时以下两项均留空。
ALIPAY_APP_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=

# 邀请注册站点当前使用 HTTP；开通证书后改为 HTTPS。独立于微信收款页面域名。
GROWTH_INVITE_BASE_URL=http://www.yxciedu.com

# 每日自动申请昨日账单（北京时间，失败任务在渠道对账页单独重试）
FINANCE_AUTO_RECONCILE=true
FINANCE_RECONCILE_HOUR=10

# 成功模型结果的私有加密恢复文件（默认 backend/data/model-results.sqlite3）
# Docker 固定使用 /home/data；多进程必须共享同一本地持久目录和 SECRET_KEY。
# MODEL_RESULT_JOURNAL_PATH=/absolute/private/path/model-results.sqlite3
MODEL_RESULT_RETENTION_DAYS=7
# 仅结算等待；不改变供应商模型生成超时。
MODEL_SETTLEMENT_TIMEOUT_SECONDS=10
