# 后端独立部署配置（不要把实际密码提交到 Git）
BACKEND_IMAGE_TAG=latest
DATABASE_USER=yuxin_ops_user
DATABASE_PASSWORD=replace_with_a_strong_password
DATABASE_NAME=yuxin_ai_ops
# 仅作用于本应用异步连接，单位毫秒；不修改共享数据库和迁移连接。
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=120000
REDIS_USER=root
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB_NAME=3
SECRET_KEY=replace_with_a_long_random_secret

# 客户端刷新令牌及 Redis 会话窗口（30天）；访问令牌及运营后台会话仍使用原配置。
CLIENT_REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# 此文件同时用于 Compose 插值及后端运行环境注入。真实文件留在服务器。
# 短信/支付等可选配置也追加在同一个文件中，不再打包 backend/env/.env.prod。
PROD_CORS_ORIGINS=https://www.yxciedu.com
GROWTH_INVITE_BASE_URL=https://www.yxciedu.com
GROWTH_PUBLIC_BASE_URL=https://www.yxciedu.com
FORWARDED_ALLOW_IPS=127.0.0.1,172.19.0.0/16

# 支付宝当面付 alipay.trade.precreate（RSA2 公钥模式）。密钥文件不进入镜像或 Git。
# 公网 API 前缀必须包含 /api/v1，代码会追加 /payment/callback/alipay。
PAYMENT_PUBLIC_BASE_URL=https://www.yxciedu.com/api/v1
PAYMENT_KEYS_HOST_DIR=/data/stacks/yuxin-ai-ops/payment-keys
CLIENT_WECHAT_LOGIN_APP_ID=
CLIENT_WECHAT_LOGIN_APP_SECRET=
CLIENT_WECHAT_LOGIN_CALLBACK_URL=https://www.yxciedu.com/api/v1/client/auth/wechat/callback
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_LOGIN=
TENCENT_SMS_TEMPLATE_REGISTER=
TENCENT_SMS_TEMPLATE_BIND=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/payment/wechat-merchant-private-key.pem
# 二选一：微信支付公钥 ID + 公钥文件，或平台证书文件。
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# 以下为容器内路径，不填写 Windows 路径或宿主机路径。
ALIPAY_PRIVATE_KEY_PATH=/run/secrets/payment/alipay-app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=/run/secrets/payment/alipay-public-key.pem

# 支付宝商户转账（推广提现）：产品审核、证书、转账场景均就绪后才启用。
GROWTH_ALIPAY_PAYOUT_ENABLED=false
# 使用 Fernet.generate_key() 单独生成并安全备份，不能用支付宝私钥代替，不随发布轮换。
GROWTH_PAYOUT_ENCRYPTION_KEY=
# 按支付宝商家平台实际申明的场景填写；上报 JSON 需含 info_type、info_content。
GROWTH_ALIPAY_TRANSFER_SCENE_NAME=
GROWTH_ALIPAY_SCENE_REPORT_JSON=
# 下列两项均留空时沿用普通公钥扫码收款；切换证书模式必须同时配置，
# 并将上面的 ALIPAY_PUBLIC_KEY_PATH 改为支付宝公钥证书 alipayCertPublicKey_RSA2.crt 的容器路径。
ALIPAY_APP_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=

# 每日自动申请昨日账单（北京时间，失败任务在渠道对账页单独重试）
FINANCE_AUTO_RECONCILE=true
FINANCE_RECONCILE_HOUR=10
