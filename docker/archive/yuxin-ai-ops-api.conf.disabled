server {
    listen 80;
    listen [::]:80;
    server_name 119.45.121.36;

    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /api/v1 {
        return 308 /api/v1/;
    }

    # FastAPI's static mount includes ROOT_PATH. Preserve /api/v1 for assets
    # while the general API proxy below continues to strip that prefix.
    location ^~ /api/v1/static/ {
        proxy_pass http://yuxin-ai-ops-backend:8001/api/v1/static/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api/v1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /api/v1/ {
        proxy_pass http://yuxin-ai-ops-backend:8001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api/v1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        client_max_body_size 50m;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
